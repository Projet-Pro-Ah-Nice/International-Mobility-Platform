generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum Continent {
  EUROPE
  ASIA
  AFRICA
  NORTH_AMERICA
  SOUTH_AMERICA
  OCEANIA
}

enum CefrLevel {
  A2
  B1
  B2
  C1
  C2
}

enum EnglishTest {
  TOEIC
  IELTS
}

enum StayPeriod {
  AUTUMN_SEMESTER
  SPRING_SEMESTER
  FULL_YEAR
}

enum DataField {
  IDENTITY
  COORDINATES
  DESCRIPTION
  COST_OF_LIFE
  PHOTO
  OTHER
}

enum CriterionType {
  NUMBER
  BOOLEAN
}

enum CriterionOrigin {
  BUILTIN
  CUSTOM
}

enum RuleType {
  WEIGHT
  THRESHOLD
  BONUS
  TIEBREAK
}

enum ComparisonOperator {
  GreaterThan
  GreaterThanOrEqual
  LessThan
  LessThanOrEqual
  Equal
}

enum AssignmentAlgorithm {
  GALE_SHAPLEY
  SERIAL_DICTATORSHIP
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum WishOutcome {
  ACCEPTED
  ELIMINATED
  OUTRANKED
  NOT_EVALUATED
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String @map("password_hash")
  role Role @default(STUDENT)

  student Student?
  notifications Notification[]
  createdConfigVersions RuleConfigurationVersion[]
  triggeredRuns AssignmentRun[]
  devices PushDevice[]
}

model Student {
  id Int @id @default(autoincrement())
  userId Int @unique
  name String
  surname String
  gpa Float
  englishTest EnglishTest
  englishScore Int
  associativeScore Int

  user User @relation(fields: [userId], references: [id])
  wishes Wish[]
  criterionValues StudentCriterionValue[]
  assignments Assignment[]
}

model Destination {
  id Int @id @default(autoincrement())
  name String
  city String
  country String
  continent Continent

  latitude Float
  longitude Float

  description String
  taughtDomains String[]
  teachingLanguages String[]
  localLife String

  monthlyHousing Float
  monthlyFood Float
  monthlyTransport Float
  monthlyTotal Float

  seats Int
  minGpa Float
  minEnglishLevel CefrLevel

  stayDurationMonths Int
  period StayPeriod
  fees Float?

  photos DestinationsPhoto[]
  sources DestinationSource[]
  wishes Wish[]
  assignments Assignment[]
  assignmentExplanation AssignmentExplanation[]
  ruleItems RuleItem[]

  @@index([continent])
  @@index([country])
}

model DestinationsPhoto {
  id Int @id @default(autoincrement())
  destinationId Int
  url String
  altText String
  author String
  license String
  licenseUrl String?
  sourceUrl String
  position Int @default(0)

  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
}

model DestinationSource {
  id Int @id @default(autoincrement())
  destinationId Int
  field DataField
  label String
  url String

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model Wish {
  id Int @id @default(autoincrement())
  studentId Int
  destinationId Int
  rank Int

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([studentId, rank])
  @@unique([studentId, destinationId])
}

model Criterion {
  id Int @id @default(autoincrement())
  key String @unique
  label String
  description String?
  type CriterionType @default(NUMBER)
  origin CriterionOrigin @default(BUILTIN)

  builtinField String?

  minValue Float?
  maxValue Float?

  studentValues StudentCriterionValue[]
  ruleItems RuleItem[]
}

model StudentCriterionValue {
  studentId Int
  criterionId Int
  value Float

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@id([studentId, criterionId])
}

model RuleConfiguration {
  id Int @id @default(autoincrement())
  name String
  description String?

  versions RuleConfigurationVersion[]
}

model RuleConfigurationVersion {
  id Int @id @default(autoincrement())
  configurationId Int
  userId Int
  version Int
  comment String?

  configuration RuleConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [userId], references: [id])
  items RuleItem[]
  runs AssignmentRun[]

  @@unique([configurationId, version])
}

model RuleItem {
  id Int @id @default(autoincrement())
  versionId Int
  type RuleType

  criterionId Int?
  destinationId Int?

  weight Float?
  operator ComparisonOperator?
  treshold Float?
  bonusPoints Float?
  descending Boolean @default(true)
  position Int @default(0)

  version RuleConfigurationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  criterion Criterion? @relation(fields: [criterionId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([versionId])
}

model AssignmentRun {
  id Int @id @default(autoincrement())
  versionId Int
  triggeredById Int
  algorithm AssignmentAlgorithm
  status RunStatus @default(PENDING)
  label String?
  isPublished Boolean @default(false)

  durationMs Int?
  firstWishRate Float?
  unassignedRate Float?
  averageRank Float?
  isStable Boolean?
  blockingPairs Int?

  version RuleConfigurationVersion @relation(fields: [versionId], references: [id])
  triggeredBy User @relation(fields: [triggeredById], references: [id])
  assignments Assignment[]
}

model Assignment {
  id Int @id @default(autoincrement())
  runId Int
  studentId Int
  destinationId Int?
  wishRank Int?
  score Float?

  run AssignmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])
  assignmentExplanation AssignmentExplanation[]

  @@unique([runId, studentId])
  @@index([runId, destinationId])
}

model AssignmentExplanation {
  id Int @id @default(autoincrement())
  assignmentId Int
  destinationId Int
  wishRank Int
  outcome WishOutcome
  studentScore Float?
  cutoffScore Float?
  message String?
  details Json?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, wishRank])
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  title String
  body String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushDevice {
  id Int @id @default(autoincrement())
  userId Int
  token String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
